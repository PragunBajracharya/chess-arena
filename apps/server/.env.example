PORT=4000
NODE_ENV=development

# Where the Next.js app runs (CORS + trusted origin for auth cookies)
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://chess:chess@localhost:5432/chess
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars
BETTER_AUTH_URL=http://localhost:4000

# Optional OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email for password reset and verification (https://resend.com).
# Leave RESEND_API_KEY blank in development: the links are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="Chess Arena <onboarding@resend.dev>"

# Profile pictures. Leave S3_BUCKET blank to store uploads in apps/server/uploads.
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
